# URL backend Revita (giữ nguyên 2 biến công khai hiện có)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Tài khoản lễ tân dùng để đặt lịch hộ khách vãng lai qua /api/book (phương án B).
# Tạo bằng POST /api/staff với vai trò RECEPTIONIST, rồi điền email + mật khẩu
# thật vào đây. KHÔNG đặt tiền tố NEXT_PUBLIC — hai biến này chỉ dùng phía server.
# LƯU Ý: mật khẩu tài khoản lễ tân do backend tự sinh, chỉ biết qua email hoặc
# log khi EMAIL_DRY_RUN=true — giữ lại mật khẩu đó khi tạo tài khoản.
REVITA_SERVICE_EMAIL=
REVITA_SERVICE_PASSWORD=
